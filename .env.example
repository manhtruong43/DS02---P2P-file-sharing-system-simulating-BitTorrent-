# =============================================================
# DS02 BitTorrent - Environment Variables Template
# Copy this file to .env and change the values:
#   Windows PowerShell : Copy-Item .env.example .env
#   Linux / macOS      : cp .env.example .env
# NEVER commit the real .env file to GitHub.
# NOTE: Do not put comments at the end of a value line,
#       Docker env_file does not strip them.
# =============================================================

# Tracker Settings
TRACKER_HOST=127.0.0.1
TRACKER_PORT=8000
TRACKER_URL=http://127.0.0.1:8000

# Peer Settings
PEER_HOST=127.0.0.1

# P2P Settings (chunk size in bytes, 262144 = 256 KB)
CHUNK_SIZE=262144

# Security Settings
# Generate your own random key, for example:
#   python -c "import secrets; print(secrets.token_hex(16))"
TRACKER_API_KEY=change_me_to_a_random_secret
